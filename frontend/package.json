{
  "name": "ehr-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve --mode development",
    "int": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode test",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode production",
    "lint": "vue-cli-service lint",
    "fix-memory-limit": "cross-env LIMIT=4096 increase-memory-limit"
  },
  "dependencies": {
    "@sentry/browser": "5.27.4",
    "@sentry/integrations": "5.27.4",
    "@tinymce/tinymce-vue": "1.1.2",
    "@types/tinymce": "4.5.16",
    "babel-polyfill": "6.26.0",
    "crypto-js": "3.1.9-1",
    "echarts": "4.2.0-rc.1",
    "es6-promise": "4.2.5",
    "jquery": "3.4.1",
    "lib-flexible-computer": "^1.0.2",
    "nprogress": "^0.2.0",
    "postcss-px2rem": "^0.3.0",
    "sm-crypto": "0.3.7",
    "terser-webpack-plugin": "^4.2.3",
    "tinymce": "4.8.3",
    "view-design": "4.0.1",
    "vtip": "1.0.6",
    "vue": "2.6.12",
    "vue-matomo": "3.13.0-4",
    "vue-preview": "^1.1.3",
    "vue-router": "3.0.1",
    "vuedraggable": "^2.24.3",
    "vuex": "3.0.1",
    "vuex-persist": "2.0.1",
    "vxe-table": "3.5.9",
    "xe-utils": "3.5.6"
  },
  "devDependencies": {
    "@sentry/webpack-plugin": "1.13.0",
    "@vue/cli-plugin-babel": "3.8.0",
    "@vue/cli-plugin-eslint": "3.0.1",
    "@vue/cli-service": "3.8.4",
    "axios": "0.19.0",
    "compression-webpack-plugin": "6.1.1",
    "cross-env": "6.0.3",
    "hard-source-webpack-plugin": "0.13.1",
    "increase-memory-limit": "1.0.7",
    "lodash-es": "^4.17.4",
    "mini-css-extract-plugin": "1.6.2",
    "node-sass": "4.13.0",
    "px2rem-loader": "^0.1.9",
    "sass": "~1.32.0",
    "sass-loader": "7.0.1",
    "vue-cli-plugin-axios": "0.0.4",
    "vue-cli-plugin-iview": "1.0.6",
    "vue-lazyload": "^1.3.3",
    "vue-template-compiler": "2.6.12"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "eslint:recommended"
    ],
    "rules": {
      "no-console": "off"
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ]
}
